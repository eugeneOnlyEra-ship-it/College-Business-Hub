# Where the backend runs (default shown)
VITE_API_URL=http://localhost:3000

# ---- Firebase AI Logic (Stall mode's hybrid AI) ----
# Firebase console > Project settings > Your apps > Web app config. These values are public by design.
# Leave them empty and Stall mode still works, with calculated answers only.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# App Check (required by Firebase AI Logic). For a public deploy, a reCAPTCHA Enterprise site key:
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# During development a debug token is printed in the browser console automatically; register it under
# App Check > Manage debug tokens. Only set this to reuse a registered token, and never in a public build.
VITE_APPCHECK_DEBUG_TOKEN=
# Cloud fallback model (default: gemini-3.5-flash-lite)
VITE_GEMINI_CLOUD_MODEL=
